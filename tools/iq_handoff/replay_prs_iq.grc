options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: ''
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: replay_prs_iq
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: replay prs iq
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [12, 12]
    rotation: 0
    state: enabled

blocks:
- name: iq_file
  id: variable
  parameters:
    comment: ''
    value: '"handoff.cf32"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [300, 30]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 30e6
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 40.0]
    rotation: 0
    state: enabled
- name: expect_response
  id: variable
  parameters:
    comment: ''
    value: 'False'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [470, 30]
    rotation: 0
    state: enabled
- name: channel
  id: ofdm_prs_ranging_prs_channel_estimator
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1168, 176.0]
    rotation: 0
    state: enabled
- name: decode_metadata
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'False'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 144.0]
    rotation: 0
    state: enabled
- name: fft
  id: ofdm_prs_ranging_prs_fft_receiver
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [872, 232.0]
    rotation: 0
    state: enabled
- name: frame_metadata
  id: blocks_message_debug
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    en_uvec: 'False'
    log_level: info
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1264, 360.0]
    rotation: 0
    state: disabled
- name: ofdm_prs_ranging_prs_window_capture_0
  id: ofdm_prs_ranging_prs_window_capture
  parameters:
    acquisition_enabled: 'True'
    affinity: ''
    alias: ''
    candidate_margin_after: '4096'
    candidate_margin_before: '4096'
    comment: ''
    maxoutbuf: '0'
    min_frame_gap: '10000'
    minoutbuf: '0'
    queue_depth: '3'
    samp_rate: samp_rate
    threshold: '0.09'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [328, 136.0]
    rotation: 0
    state: enabled
- name: ofdm_prs_ranging_prs_zc_frame_sync_0
  id: ofdm_prs_ranging_prs_zc_frame_sync
  parameters:
    affinity: ''
    alias: ''
    channel_id: '0'
    expect_response: expect_response
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    preamble_threshold: '0.15'
    samp_rate: samp_rate
    zc_threshold: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 372.0]
    rotation: 0
    state: enabled
- name: read_iq
  id: blocks_file_source
  parameters:
    affinity: ''
    alias: ''
    begin_tag: pmt.PMT_NIL
    comment: ''
    file: iq_file
    length: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    offset: '000000'
    repeat: 'False'
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [24, 180]
    rotation: 0
    state: enabled
- name: virtual_sink_1_0_0_0_0_1_0_0
  id: virtual_sink
  parameters:
    alias: ''
    comment: ''
    stream_id: slot
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [992, 504.0]
    rotation: 0
    state: enabled
- name: virtual_source_1_0_0_0_1_0_0_0_0_0
  id: virtual_source
  parameters:
    alias: ''
    comment: ''
    stream_id: slot
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [80, 336.0]
    rotation: 0
    state: enabled

connections:
- [channel, channel_out, decode_metadata, print]
- [fft, symbols_out, channel, symbols_in]
- [ofdm_prs_ranging_prs_window_capture_0, candidate_out, ofdm_prs_ranging_prs_zc_frame_sync_0,
  candidate_in]
- [ofdm_prs_ranging_prs_zc_frame_sync_0, diagnostics_out, frame_metadata, print]
- [ofdm_prs_ranging_prs_zc_frame_sync_0, slot_release, virtual_sink_1_0_0_0_0_1_0_0,
  '0']
- [ofdm_prs_ranging_prs_zc_frame_sync_0, synchronized_frame_out, fft, frame_in]
- [read_iq, '0', ofdm_prs_ranging_prs_window_capture_0, '0']
- [virtual_source_1_0_0_0_1_0_0_0_0_0, '0', ofdm_prs_ranging_prs_window_capture_0,
  slot_release]

metadata:
  file_format: 1
  grc_version: 3.10.11.0
