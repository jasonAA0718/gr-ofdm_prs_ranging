options:
  parameters:
    author: cnsl
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: PlutoSDR untimed PRS initiator with bounded raw capture
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: PlutoSDR_Initiator
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: PlutoSDR PRS Initiator
    window_size: (1200,900)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: capture_samples
  id: variable
  parameters:
    comment: Two seconds; complex float32 is 80 MB/s at 10 MS/s
    value: int(2*samp_rate)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 24]
    rotation: 0
    state: enabled
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: int(1060e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [168, 24]
    rotation: 0
    state: enabled
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: int(10e6)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [456, 24.0]
    rotation: 0
    state: enabled
- name: acquisition_log
  id: ofdm_prs_ranging_prs_acquisition_logger
  parameters:
    affinity: ''
    alias: ''
    append: 'True'
    comment: ''
    node: '"pluto_initiator"'
    path: '"CSV/pluto_initiator_acquisition.csv"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [744, 848.0]
    rotation: 0
    state: enabled
- name: channel_estimator
  id: ofdm_prs_ranging_prs_channel_estimator
  parameters:
    active_bins: '1024'
    affinity: ''
    alias: ''
    comment: ''
    fft_len: '1024'
    maxoutbuf: '0'
    minoutbuf: '0'
    prs_symbols: '16'
    samp_rate: samp_rate
    seed: '13990001'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [848, 416.0]
    rotation: 0
    state: enabled
- name: detector
  id: ofdm_prs_ranging_prs_frame_detector
  parameters:
    active_bins: '1024'
    affinity: ''
    alias: ''
    channel_id: '29'
    coarse_sync_len: '839'
    coarse_zc_root: '29'
    comment: ''
    cp_len: '128'
    fft_len: '1024'
    maxoutbuf: '0'
    min_frame_gap: '10000'
    minoutbuf: '0'
    preamble_len: '128'
    preamble_repeats: '16'
    prs_symbols: '16'
    reply_delay_s: '0.05'
    samp_rate: samp_rate
    tail_guard_len: '1000'
    threshold: '0.35'
    time_gating: 'False'
    window_after_s: '0.004'
    window_before_s: '0.0002'
    zc_threshold: '0.35'
    zero_guard_len: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [304, 728.0]
    rotation: 0
    state: enabled
- name: fft_receiver
  id: ofdm_prs_ranging_prs_fft_receiver
  parameters:
    active_bins: '1024'
    affinity: ''
    alias: ''
    comment: ''
    cp_len: '128'
    fft_len: '1024'
    maxoutbuf: '0'
    minoutbuf: '0'
    prs_symbols: '16'
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [704, 648.0]
    rotation: 0
    state: enabled
- name: iio_rx
  id: iio_pluto_source
  parameters:
    affinity: ''
    alias: ''
    bandwidth: '10000000'
    bbdc: 'True'
    buffer_size: 32768*128
    comment: ''
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: center_freq
    fstop: '0'
    gain1: '''manual'''
    len_tag_key: packet_len
    manual_gain1: '20'
    maxoutbuf: '0'
    minoutbuf: '0'
    quadrature: 'True'
    rfdc: 'True'
    samplerate: samp_rate
    type: fc32
    uri: ip:192.168.6.10
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 428.0]
    rotation: 0
    state: enabled
- name: iio_tx
  id: iio_pluto_sink
  parameters:
    affinity: ''
    alias: ''
    attenuation1: '10.0'
    bandwidth: '10000000'
    buffer_size: 32768*128
    comment: ''
    cyclic: 'False'
    filter: ''
    filter_source: '''Auto'''
    fpass: '0'
    frequency: center_freq
    fstop: '0'
    len_tag_key: ''
    samplerate: samp_rate
    type: fc32
    uri: ip:192.168.6.10
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [904, 204.0]
    rotation: 0
    state: enabled
- name: measurement_log
  id: ofdm_prs_ranging_prs_csv_logger
  parameters:
    affinity: ''
    alias: ''
    append: 'True'
    comment: ''
    path: '"CSV/pluto_initiator_phase_slope.csv"'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1664, 440.0]
    rotation: 0
    state: enabled
- name: phase_slope
  id: ofdm_prs_ranging_prs_phase_slope_estimator
  parameters:
    active_bins: '1024'
    affinity: ''
    alias: ''
    comment: ''
    fft_len: '1024'
    max_residual_rms: '1.0'
    maxoutbuf: '0'
    minoutbuf: '0'
    samp_rate: samp_rate
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1192, 432.0]
    rotation: 0
    state: enabled
- name: pluto_tx
  id: ofdm_prs_ranging_pluto_prs_burst_source
  parameters:
    active_bins: '1024'
    affinity: ''
    alias: ''
    coarse_sync_len: '839'
    coarse_zc_root: '25'
    comment: ''
    cp_len: '128'
    default_packet_type: '1'
    fft_len: '1024'
    guard_samples: '0'
    maxoutbuf: '0'
    minoutbuf: '0'
    preamble_len: '128'
    preamble_repeats: '16'
    prs_symbols: '16'
    samp_rate: samp_rate
    seed: '13990001'
    tail_guard_len: '1000'
    tx_amp: '0.6'
    zero_guard_len: '1000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 144.0]
    rotation: 0
    state: enabled
- name: poll_strobe
  id: blocks_message_strobe
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    msg: pmt.PMT_T
    period: '500'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [56, 264.0]
    rotation: 0
    state: enabled
- name: rx_file
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: '"CSV/pluto_initiator_rx.c64"'
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [408, 456.0]
    rotation: 0
    state: disabled
- name: rx_head
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: capture_samples
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [264, 472.0]
    rotation: 0
    state: disabled
- name: text_ui
  id: ofdm_prs_ranging_prs_text_ui
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    refresh_period_s: '0.25'
    response_timeout_s: '1.0'
    role: '"initiator"'
    stale_timeout_s: '1.5'
    use_ansi: 'True'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [1352, 584.0]
    rotation: 0
    state: enabled
- name: tx_file
  id: blocks_file_sink
  parameters:
    affinity: ''
    alias: ''
    append: 'False'
    comment: ''
    file: '"CSV/pluto_initiator_tx.c64"'
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [840, 72.0]
    rotation: 0
    state: disabled
- name: tx_head
  id: blocks_head
  parameters:
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
    num_items: capture_samples
    type: complex
    vlen: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [640, 88.0]
    rotation: 0
    state: disabled

connections:
- [channel_estimator, channel_out, phase_slope, channel_in]
- [detector, event_out, acquisition_log, frame_in]
- [detector, frame_out, fft_receiver, frame_in]
- [detector, frame_out, text_ui, frame_in]
- [fft_receiver, symbols_out, channel_estimator, symbols_in]
- [iio_rx, '0', detector, '0']
- [iio_rx, '0', rx_head, '0']
- [phase_slope, measurement_out, measurement_log, measurement_in]
- [phase_slope, measurement_out, text_ui, measurement_in]
- [pluto_tx, '0', iio_tx, '0']
- [pluto_tx, '0', tx_head, '0']
- [pluto_tx, tx_event_out, text_ui, tx_in]
- [poll_strobe, strobe, pluto_tx, trigger]
- [rx_head, '0', rx_file, '0']
- [tx_head, '0', tx_file, '0']

metadata:
  file_format: 1
  grc_version: 3.10.11.0
