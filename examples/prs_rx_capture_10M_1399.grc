    alias: ''
    append: 'False'
    comment: ''
    file: captures/rx_prs_10M_1399.c64
    type: complex
    unbuffered: 'False'
    vlen: '1'
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [760, 360.0], rotation: 0, state: enabled}
