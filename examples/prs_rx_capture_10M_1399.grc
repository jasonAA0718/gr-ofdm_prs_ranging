    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '0'
    step: '0.01'
    stop: '1'
    value: '0.2'
    widget: counter_slider
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [320, 24.0], rotation: 0, state: enabled}
- name: blocks_file_sink_0
  id: blocks_file_sink
  parameters:
