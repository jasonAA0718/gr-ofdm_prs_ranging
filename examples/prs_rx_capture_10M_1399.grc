options:
  parameters:
    author: ''
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: Raw complex64 PRS capture at 10 MHz and 1399 MHz
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: prs_rx_capture_10M_1399
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: PRS RX Capture 10M 1399
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [64, 20.0]
    rotation: 0
    state: enabled

blocks:
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: 10e6
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [184, 24.0], rotation: 0, state: enabled}
- name: center_freq
  id: variable
  parameters:
    comment: ''
    value: 1399e6
  states: {bus_sink: false, bus_source: false, bus_structure: null, coordinate: [184, 88.0], rotation: 0, state: enabled}
- name: rx_gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: ''
